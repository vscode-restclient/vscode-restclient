# ==== Examples with httpbun.com ====
# httpbun.com is a simple HTTP Request & Response Service.

@host = https://httpbun.com
@var1 = variableValue

# ==== GET ====
### A simple GET request.
GET {{host}}/get

### Basic Authentication.
GET {{host}}/basic-auth/user/pass
Authorization: Basic user pass

# ==== Cookies ====
### Set cookies
GET {{host}}/cookies/set?foo=bar

### Check cookies
GET {{host}}/cookies

# ==== Issue 3 - change to @xmldom/xmldom ====
### POST with XML body.
# @name testMixXmlJson
POST {{host}}/post
Content-Type: application/xml
Authorization: Basic user pass

<note>
  <to>User</to>
  <from>Tester</from>
  <heading>Reminder</heading>
  <body>This is a test for {{var1}}.</body>
</note>

### Get a person XML data: <person><firstname>Jane</firstname><lastname>Do</lastname></person>
# @name testXml
GET {{host}}/mix/s=200/h=content-type:application%2Fxml/b64=PHBlcnNvbj48Zmlyc3RuYW1lPkphbmU8L2ZpcnN0bmFtZT48bGFzdG5hbWU+RG88L2xhc3RuYW1lPjwvcGVyc29uPg==
Content-Type: application/xml

### Send firstname from testXML response
@firtname = {{testXml.response.body./person/firstname}}

POST {{host}}/post HTTP/1.1

{{firtname}}

### GET bytes

# @name testBytes
GET {{host}}/bytes/10
Accept: application/octet-stream

### Issue #8: Special characters in Basic Auth credentials.

# The first space in the password is changed in colon
# user=admin
# password: it's a total eclipse
GET {{host}}/basic-auth/admin/it's a total eclipse
Content-type: application/json
Authorization: Basic admin it's a total eclipse

### Faker
POST {{host}}/post
Content-Type: application/json

{
    "name": "{{$faker person.firstName}} {{$faker person.lastName}}",
    "email": "{{$faker internet.email}}"
}

### Head Request
HEAD {{host}}/get

### 404 request
GET {{host}}/status/404
